page = PAGE
page.10 = PAGEVIEW
page.10 {
    paths {
        100 = EXT:mein_site_package/Resources/Private/PageView/
    }
    dataProcessing {
        10 = page-content
       20 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
20 {
    as = mainMenu
    special = list
    special.value = 8,9
    levels = 3
    expandAll = 1
    titleField = nav_title // title
}
   # Sprache  Menue
        30 = language-menu
        30 {
            languages = auto
            as = languageNavigation
        }
    }
}
config.contentObjectExceptionHandler = 0